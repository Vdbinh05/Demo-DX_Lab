# SPDX-License-Identifier: MIT
DXLAB_SQL_SERVER=localhost,1433
DXLAB_SQL_DATABASE=DXLabCore
DXLAB_SQL_USER=sa
DXLAB_SQL_PASSWORD=replace-with-your-local-password
DXLAB_SQL_DRIVER={ODBC Driver 17 for SQL Server}
# Để trống ở máy dev để backend tạo backend/.auth-secret ổn định và được Git bỏ qua.
# Khi triển khai production, đặt một chuỗi ngẫu nhiên dài qua biến môi trường bảo mật.
DXLAB_AUTH_SECRET=
DXLAB_ACCESS_TOKEN_MINUTES=480
DXLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
